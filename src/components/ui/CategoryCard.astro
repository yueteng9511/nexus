---
/** 分類卡片：代號、名稱、描述、文章數。用於首頁與分類總覽。 */
import type { Category } from '../../lib/content';
import { categoryUrl } from '../../lib/url';

interface Props {
  category: Category;
  count: number;
}
const { category, count } = Astro.props;
const { name, code, description } = category.data;
---

<a class="category-card" href={categoryUrl(category.id)}>
  <div class="top">
    <span class="code">{code}</span>
    <span class="count">{count === 1 ? '1 article' : `${count} articles`}</span>
  </div>
  <h3 class="name">{name}</h3>
  <p class="description">{description}</p>
</a>

<style>
  .category-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-5) var(--space-6) var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    transition: border-color var(--duration-fast) var(--ease), background var(--duration-fast) var(--ease);
  }

  .category-card:hover {
    border-color: var(--color-border-strong);
    background: var(--color-surface-raised);
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-4);
  }

  .code {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    color: var(--color-accent);
  }

  .count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .name {
    font-size: var(--text-lg);
    transition: color var(--duration-fast) var(--ease);
  }

  .category-card:hover .name {
    color: var(--color-accent);
  }

  .description {
    font-size: var(--text-sm);
  }
</style>
