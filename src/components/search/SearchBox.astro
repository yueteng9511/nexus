---
/**
 * 搜尋框 + 即時結果列表。全站唯一的搜尋 UI。
 *   variant="hero"：首頁使用，結果在輸入框下方展開
 *   variant="page"：搜尋頁使用，會讀寫網址 ?q=，方便分享搜尋結果
 *
 * 沒有 JavaScript 時，表單會以 GET 送到 /search/?q=...（漸進增強）。
 * 搜尋邏輯：見下方 <script> 的 score()；索引格式：見 src/lib/search.ts。
 */
import { url } from '../../lib/url';

interface Props {
  variant?: 'hero' | 'page';
  /** 空白時顯示的建議關鍵字 */
  suggestions?: string[];
}

const { variant = 'hero', suggestions = [] } = Astro.props;
const inputId = `search-${variant}`;
---

<div
  class:list={['search', variant]}
  data-search
  data-index={url('/search-index.json')}
  data-sync-url={variant === 'page' ? 'true' : undefined}
>
  <form action={url('/search/')} method="get" role="search">
    <label for={inputId} class="visually-hidden">Search NEXUS</label>
    <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.75"></circle>
      <path d="m16 16 4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
    </svg>
    <input
      id={inputId}
      name="q"
      type="search"
      autocomplete="off"
      spellcheck="false"
      placeholder="搜尋概念、分類或關鍵字，例如 stack、LIFO、二分搜尋"
      data-search-input
    />
    <kbd class="hint" aria-hidden="true">/</kbd>
  </form>

  {
    suggestions.length > 0 && (
      <div class="suggestions" data-search-suggestions>
        <span class="eyebrow">Try</span>
        {suggestions.map((s) => (
          <button type="button" data-suggestion={s}>
            {s}
          </button>
        ))}
      </div>
    )
  }

  <p class="status" data-search-status aria-live="polite"></p>
  <ul class="results" data-search-results hidden></ul>
</div>

<script>
  interface SearchEntry {
    title: string;
    description: string;
    keywords: string[];
    categoryName: string;
    categoryCode: string;
    url: string;
  }

  interface IndexedEntry extends SearchEntry {
    n: { title: string; keywords: string[]; category: string; description: string };
  }

  const normalize = (text: string) => text.normalize('NFKC').toLowerCase().trim();

  let indexPromise: Promise<IndexedEntry[]> | undefined;
  function loadIndex(src: string) {
    indexPromise ??= fetch(src)
      .then((response) => response.json() as Promise<SearchEntry[]>)
      .then((entries) =>
        entries.map((entry) => ({
          ...entry,
          n: {
            title: normalize(entry.title),
            keywords: entry.keywords.map(normalize),
            category: normalize(`${entry.categoryName} ${entry.categoryCode}`),
            description: normalize(entry.description),
          },
        })),
      );
    return indexPromise;
  }

  /**
   * 計分：每個搜尋詞都必須命中至少一個欄位，否則回傳 0（不顯示）。
   * 權重：標題 > 關鍵字 > 分類 > 描述。
   */
  function score(entry: IndexedEntry, terms: string[]): number {
    let total = 0;
    for (const term of terms) {
      const { title, keywords, category, description } = entry.n;
      let best = 0;
      if (title === term) best = 100;
      else if (title.startsWith(term)) best = 70;
      else if (title.includes(term)) best = 50;
      if (keywords.some((k) => k === term)) best = Math.max(best, 60);
      else if (keywords.some((k) => k.includes(term))) best = Math.max(best, 35);
      if (category.includes(term)) best = Math.max(best, 20);
      if (description.includes(term)) best = Math.max(best, 10);
      if (best === 0) return 0;
      total += best;
    }
    return total;
  }

  function renderResult(entry: SearchEntry): HTMLLIElement {
    const li = document.createElement('li');
    const a = document.createElement('a');
    a.className = 'result';
    a.href = entry.url;
    const meta = document.createElement('span');
    meta.className = 'result-meta';
    meta.textContent = `${entry.categoryCode} · ${entry.categoryName}`;
    const title = document.createElement('span');
    title.className = 'result-title';
    title.textContent = entry.title;
    const description = document.createElement('span');
    description.className = 'result-description';
    description.textContent = entry.description;
    a.append(meta, title, description);
    li.append(a);
    return li;
  }

  function setup(root: HTMLElement) {
    const input = root.querySelector<HTMLInputElement>('[data-search-input]')!;
    const results = root.querySelector<HTMLUListElement>('[data-search-results]')!;
    const status = root.querySelector<HTMLElement>('[data-search-status]')!;
    const suggestions = root.querySelector<HTMLElement>('[data-search-suggestions]');
    const form = root.querySelector('form')!;
    const syncUrl = root.dataset.syncUrl === 'true';
    const src = root.dataset.index!;

    async function update() {
      const query = input.value;
      const terms = normalize(query).split(/\s+/).filter(Boolean);

      if (syncUrl) {
        const next = new URL(window.location.href);
        if (query.trim()) next.searchParams.set('q', query.trim());
        else next.searchParams.delete('q');
        history.replaceState(null, '', next);
      }

      if (suggestions) suggestions.hidden = terms.length > 0;

      if (terms.length === 0) {
        results.hidden = true;
        results.replaceChildren();
        status.textContent = '';
        return;
      }

      const index = await loadIndex(src);
      if (input.value !== query) return; // 使用者已經繼續輸入，丟棄過期結果

      const matches = index
        .map((entry) => ({ entry, score: score(entry, terms) }))
        .filter((m) => m.score > 0)
        .sort((a, b) => b.score - a.score || a.entry.title.localeCompare(b.entry.title));

      results.replaceChildren(...matches.map((m) => renderResult(m.entry)));
      results.hidden = matches.length === 0;
      status.textContent =
        matches.length === 0
          ? `找不到「${query.trim()}」相關的內容。試試英文名稱、中文名稱或分類名稱。`
          : `${matches.length} ${matches.length === 1 ? 'result' : 'results'}`;
    }

    input.addEventListener('input', update);
    input.addEventListener('focus', () => loadIndex(src), { once: true });

    // Enter：直接前往第一筆結果
    form.addEventListener('submit', (event) => {
      const first = results.querySelector<HTMLAnchorElement>('a');
      if (first && !results.hidden) {
        event.preventDefault();
        window.location.href = first.href;
      } else if (syncUrl) {
        event.preventDefault();
      }
    });

    // 方向鍵在輸入框與結果之間移動
    root.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
      const links = [...results.querySelectorAll<HTMLAnchorElement>('a')];
      if (results.hidden || links.length === 0) return;
      const current = links.indexOf(document.activeElement as HTMLAnchorElement);
      event.preventDefault();
      if (event.key === 'ArrowDown') links[Math.min(current + 1, links.length - 1)].focus();
      else if (current <= 0) input.focus();
      else links[current - 1].focus();
    });

    suggestions?.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-suggestion]');
      if (!button) return;
      input.value = button.dataset.suggestion!;
      input.focus();
      update();
    });

    if (syncUrl) {
      const initial = new URLSearchParams(window.location.search).get('q');
      if (initial) {
        input.value = initial;
        update();
      }
    }
  }

  document.querySelectorAll<HTMLElement>('[data-search]').forEach(setup);
</script>

<style>
  .search {
    width: 100%;
  }

  form {
    position: relative;
    display: flex;
    align-items: center;
  }

  .icon {
    position: absolute;
    left: var(--space-4);
    color: var(--color-text-muted);
    pointer-events: none;
  }

  input {
    width: 100%;
    height: 3rem;
    padding: 0 var(--space-12) 0 calc(var(--space-4) + 18px + var(--space-3));
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    font-size: var(--text-base);
    color: var(--color-text);
    transition: border-color var(--duration-fast) var(--ease), background var(--duration-fast) var(--ease);
  }

  input::placeholder {
    color: var(--color-text-muted);
  }

  input:hover {
    background: var(--color-surface-raised);
  }

  input:focus {
    outline: none;
    border-color: var(--color-accent-border);
    background: var(--color-surface-raised);
  }

  input::-webkit-search-cancel-button {
    display: none;
  }

  .hint {
    position: absolute;
    right: var(--space-4);
    pointer-events: none;
  }

  input:focus ~ .hint {
    display: none;
  }

  .page input {
    height: 3.5rem;
    font-size: var(--text-md);
  }

  .suggestions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .suggestions[hidden] {
    display: none;
  }

  .suggestions .eyebrow {
    margin-right: var(--space-1);
  }

  .suggestions button {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: transparent;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    transition: border-color var(--duration-fast) var(--ease), color var(--duration-fast) var(--ease);
  }

  .suggestions button:hover {
    border-color: var(--color-accent-border);
    color: var(--color-accent);
  }

  .status {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .status:empty {
    display: none;
  }

  .results {
    margin-top: var(--space-2);
    padding: var(--space-1);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    list-style: none;
  }

  /* 結果是由 script 動態產生的，Astro 的 scoped style 套不到，所以用 :global */
  .results :global(.result) {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
  }

  .results :global(.result:hover),
  .results :global(.result:focus-visible) {
    background: var(--color-surface-raised);
    outline: none;
  }

  .results :global(.result-meta) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-accent);
  }

  .results :global(.result-title) {
    font-weight: var(--weight-semibold);
    color: var(--color-text);
  }

  .results :global(.result-description) {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }
</style>
