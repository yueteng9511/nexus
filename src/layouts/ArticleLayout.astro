---
/**
 * 知識文章版型：所有文章頁共用，由 src/pages/articles/[slug].astro 呼叫。
 * 結構：ArticleHeader → 手機目錄 → 內文（.prose）→ RelatedTopics；桌面版右側固定目錄。
 * 修改這裡會影響「所有」文章頁。
 */
import '../styles/prose.css';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import ArticleHeader from '../components/article/ArticleHeader.astro';
import TableOfContents from '../components/article/TableOfContents.astro';
import RelatedTopics from '../components/article/RelatedTopics.astro';
import type { Article, Category } from '../lib/content';

interface Props {
  article: Article;
  category: Category;
  headings: MarkdownHeading[];
  related: Article[];
}
const { article, category, headings, related } = Astro.props;
const hasRelated = related.length > 0;
---

<BaseLayout title={article.data.title} description={article.data.description}>
  <div class="container layout">
    <article class="article">
      <ArticleHeader article={article} category={category} />

      <details class="toc-mobile">
        <summary class="eyebrow">On this page</summary>
        <TableOfContents headings={headings} hasRelated={hasRelated} />
      </details>

      <div class="prose">
        <slot />
      </div>

      <RelatedTopics articles={related} />
    </article>

    <aside class="toc-desktop">
      <p class="eyebrow">On this page</p>
      <TableOfContents headings={headings} hasRelated={hasRelated} />
    </aside>
  </div>
</BaseLayout>

<script>
  // 為每個程式碼區塊加上「Copy」按鈕（樣式在 prose.css 的 .copy-button）
  document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'copy-button';
    button.textContent = 'Copy';
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? '');
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Failed';
      }
      setTimeout(() => (button.textContent = 'Copy'), 1500);
    });
    pre.append(button);
  });
</script>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-content: center;
    padding-block: var(--space-12) var(--space-24);
  }

  .article {
    width: 100%;
    max-width: var(--width-prose);
    margin-inline: auto;
  }

  .toc-mobile {
    margin-bottom: var(--space-10);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .toc-mobile summary {
    cursor: pointer;
  }

  .toc-mobile[open] summary {
    margin-bottom: var(--space-4);
  }

  .toc-desktop {
    display: none;
  }

  @media (min-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, var(--width-prose)) var(--width-toc);
      gap: var(--space-16);
    }

    .article {
      margin-inline: 0;
    }

    .toc-mobile {
      display: none;
    }

    .toc-desktop {
      display: block;
      position: sticky;
      top: calc(var(--header-height) + var(--space-12));
      align-self: start;
      max-height: calc(100vh - var(--header-height) - var(--space-16));
      overflow-y: auto;
    }

    .toc-desktop .eyebrow {
      margin-bottom: var(--space-4);
    }
  }
</style>
