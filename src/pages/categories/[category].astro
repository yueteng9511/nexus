---
/**
 * 分類頁路由：為 src/content/categories/ 裡的每個 .yaml 自動產生 /categories/<id>/。
 * 新增分類「不需要」修改這個檔案。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import ArticleCard from '../../components/ui/ArticleCard.astro';
import { getArticlesByCategory, getCategories, type Category } from '../../lib/content';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const categories = await getCategories();
  return categories.map((category) => ({ params: { category: category.id }, props: { category } }));
}

interface Props {
  category: Category;
}

const { category } = Astro.props;
const articles = await getArticlesByCategory(category.id);
const { name, code, description } = category.data;
---

<BaseLayout title={name} description={description}>
  <PageHeader eyebrow={`Category · ${code}`} title={name} description={description}>
    <p class="count">{articles.length === 1 ? '1 article' : `${articles.length} articles`}</p>
  </PageHeader>

  <section class="container list" aria-label={`${name} articles`}>
    {
      articles.length > 0 ? (
        <ul>
          {articles.map((article) => (
            <li>
              <ArticleCard article={article} variant="row" />
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty">
          <p>這個分類還沒有文章。</p>
          <a href={url('/categories/')}>瀏覽其他分類 →</a>
        </div>
      )
    }
  </section>
</BaseLayout>

<style>
  .count {
    margin-top: var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .list {
    padding-bottom: var(--space-24);
  }

  ul {
    max-width: var(--width-prose);
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .empty {
    max-width: var(--width-prose);
    padding: var(--space-10) var(--space-6);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-lg);
    text-align: center;
  }

  .empty a {
    display: inline-block;
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-accent);
  }
</style>
